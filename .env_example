# ============================================================
#  LLM Provider API Keys
#  Uncomment and fill in the key(s) for the provider you use.
# ============================================================

# --- OpenAI ---
# Models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo, etc.
# create_agent("openai:gpt-4o", tools)
OPENAI_API_KEY=your-openai-api-key-here

# --- Anthropic (Claude) ---
# Models: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.
# create_agent("anthropic:claude-3-5-sonnet-20241022", tools)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Google Generative AI (Gemini) ---
# Models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash, etc.
# create_agent("google-genai:gemini-2.0-flash", tools)
# GOOGLE_API_KEY=your-google-api-key-here

# --- Groq ---
# Models: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it, etc.
# create_agent("groq:llama-3.3-70b-versatile", tools)
# GROQ_API_KEY=your-groq-api-key-here

# --- Mistral AI ---
# Models: mistral-large-latest, mistral-small-latest, open-mistral-7b, etc.
# create_agent("mistralai:mistral-large-latest", tools)
# MISTRAL_API_KEY=your-mistral-api-key-here

# --- Cohere ---
# Models: command-r-plus, command-r, command, etc.
# create_agent("cohere:command-r-plus", tools)
# COHERE_API_KEY=your-cohere-api-key-here

# --- Azure OpenAI ---
# create_agent("azure_openai:gpt-4o", tools)
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# --- AWS Bedrock ---
# Models: anthropic.claude-3-5-sonnet-20241022-v2:0, amazon.titan-text-express-v1, etc.
# BEDROCK_AWS_ACCESS_KEY_ID=your-aws-access-key-id
# BEDROCK_AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# BEDROCK_AWS_REGION=us-east-1

# --- Ollama (local) ---
# Models: llama3.2, phi4, mistral, deepseek-r1, qwen2.5, etc.
# Requires Ollama running locally: https://ollama.com
# create_agent("ollama:llama3.2", tools)
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
#  MCP Server Credentials
# ============================================================

# --- GitHub MCP Server ---
# Personal Access Token with the required scopes for the GitHub MCP server.
GITHUB_MCP_PAT=your-github-personal-access-token-here
